# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# HenrikDev Valorant API (https://docs.henrikdev.xyz - request a free key)
HENRIK_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte hex key used to encrypt Riot store session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=

# Comma-separated Discord user IDs allowed to run bot-wide admin commands (/봇상태, /캐시초기화).
BOT_OWNER_IDS=

# Riot Mobile QR login locale.
RIOT_QR_LOCALE=ko-KR
